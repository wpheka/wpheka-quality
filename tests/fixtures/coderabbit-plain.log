  +                // Check if challenge was already completed (CAVV data available)
  +                $session = WC()->session;
  +                $cavv = $session ? $session->get('threeds_cavv') : '';

  Then replace the remaining WC()->session-> calls in this method with
  $session and skip the session writes when $session is null.



